{
	"name": "my-cookbook-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"gen:types": "cargo run --quiet -p cookbook-cli -- schema web | node scripts/gen-types.mjs",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.0.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^16.0.0",
		"happy-dom": "^20.14.6",
		"json-schema-to-typescript": "^15.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/bitter": "^5.3.0",
		"@fontsource/literata": "^5.3.0"
	}
}
