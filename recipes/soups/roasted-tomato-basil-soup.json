  "steps": [
    {
      "text": "Preheat oven to 200°C. Place tomatoes cut-side up on large baking tray. Add onions, red pepper, and whole garlic bulb."
    },
    {
      "text": "Drizzle with olive oil and balsamic vinegar. Sprinkle with sugar, salt, and pepper."
    },
    {
      "text": "Roast 40-45 minutes until tomatoes are collapsed and edges caramelised."
    },
    {
      "text": "Squeeze roasted garlic cloves from skin into bowl."
    },
    {
      "text": "Transfer everything to large pot. Add stock and most of basil."
    },
    {
      "text": "Simmer 10 minutes. Blend until smooth."
    },
    {
      "text": "Add cream if desired. Reheat gently before serving."
    },
    {
      "text": "Garnish with fresh basil, drizzle of olive oil. Serve with crusty bread."
    }
  ],
  "tips": [
    "Roasting concentrates tomato flavour and adds smoky sweetness. Make 1-2 days ahead - flavours deepen beautifully. Reheat gently, do not boil after adding cream."
  ]
}
