  "steps": [
    {
      "text": "Cut the chicken breast into 3 cm cubes. Combine the chicken with the yoghurt, the turmeric and the salt. Cover and refrigerate for {timer:30|marinade}.",
      "time": {
        "active": 5,
        "passive": 30
      }
    },
    {
      "text": "Heat the ghee in a large heavy-based pan over a medium heat. Cook the onions for {timer:10-12}, stirring frequently, until soft and pale golden.",
      "time": {
        "active": 12
      }
    },
    {
      "text": "Add the garlic and cook for {timer:30s}. Stir in the ginger, coriander, cumin, chilli powder and cloves and cook for a further {timer:30s}. Add a splash of water if the spices stick.",
      "time": {
        "active": 1
      }
    },
    {
      "text": "Add the marinated chicken and cook over a medium-high heat for {timer:8}, turning occasionally, until sealed and no raw pink remains.",
      "time": {
        "active": 8
      }
    },
    {
      "text": "Stir in the ground almonds, coconut milk and chicken stock. Bring to a gentle simmer, cover, and cook over a low heat for {timer:20|korma}, stirring occasionally.",
      "time": {
        "active": 2,
        "passive": 18
      }
    },
    {
      "text": "Stir in the garam masala and lemon juice. Simmer uncovered for {timer:5-10}, until the sauce coats the back of a spoon. Adjust the salt and serve topped with the flaked almonds and fresh coriander.",
      "time": {
        "active": 2,
        "passive": 6
      }
    }
  ]
}
