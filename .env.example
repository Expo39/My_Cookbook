# Copy to .env. It is git-ignored, so the secrets stay on this machine.
# Wrap values that contain "$" in single quotes, so that Compose does not expand them.

# Required. Create it with:
#   printf '%s' 'your password' | docker compose run --rm -T dev cargo run -q -p cookbook-server -- --hash-password
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace-me'

# Required. At least 32 characters, e.g. from `openssl rand -hex 32`.
SESSION_SECRET=

# Optional. Without a key the sous-chef and the importer are switched off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set to true to commit every edit (also mount ./.git in docker-compose.yml).
GIT_COMMIT=false

# Behind Caddy or another proxy over HTTPS, keep these two as they are.
# For http://localhost, set COOKIE_SECURE=false, or the browser drops the cookie.
COOKIE_SECURE=true
TRUST_PROXY=true

# The host port for the selfhost service.
SELFHOST_PORT=8080
